# GetME! configuration
# Copy to .env and fill in values.

# --- Google Drive ---
# Preferred: OAuth "Sign in with Google". Create an OAuth client (Web application)
# in Google Cloud Console, add http://localhost:8000/api/auth/google/callback as an
# authorized redirect URI, download the client secrets JSON, and point this at it.
# Then connect an account from the admin console (/admin).
GOOGLE_OAUTH_CLIENT_FILE=oauth_client.json

# Base URL this server is reachable at (used for the OAuth redirect).
PUBLIC_BASE_URL=http://localhost:8000

# When using the cloud relay, set both to the event's public URL, e.g.:
# PUBLIC_BASE_URL=https://relay.example.com/e/wedding
# PATH_PREFIX=/e/wedding
PATH_PREFIX=

# Fallback: a service account JSON key. Used only when no Google account is
# connected. Share the photo folder with the service account's email.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- Face recognition ---
# DeepFace model + detector. ArcFace + retinaface are the project defaults.
FACE_MODEL=ArcFace
FACE_DETECTOR=retinaface

# Cosine-distance eps for DBSCAN clustering (lower = stricter grouping).
CLUSTER_EPS=0.40
# Minimum samples for a DBSCAN core point.
CLUSTER_MIN_SAMPLES=2
# Minimum cosine similarity for a selfie to match a cluster centroid.
MATCH_THRESHOLD=0.50

# Minimum detected-face width as a fraction of image width (quality filter).
MIN_FACE_WIDTH_FRACTION=0.03
# Minimum detector confidence to keep a face.
MIN_FACE_CONFIDENCE=0.50

# --- Processing ---
# Number of worker processes for parallel image processing (0 = auto / cpu_count).
WORKER_PROCESSES=0

# --- Cloud relay (optional) ---
# Set these when running GetME on a videographer laptop connected to your relay.
# The studio install script writes them automatically.
RELAY_URL=
RELAY_SESSION=
RELAY_AGENT_SECRET=

# --- App ---
# Simple shared secret to protect admin/processing endpoints.
ADMIN_TOKEN=change-me
# Download/gallery token lifetime in seconds.
TOKEN_TTL_SECONDS=86400
# SQLite database path.
DATABASE_PATH=data/getme.db
